 "classes": [
  "A",
  "B"
 ],
 "controls": {
  "different": "event_key",
  "distance": "|dlog X1| + |dlog(1 + days to end)|",
  "k": 5,
  "pool": "pass every non-identity gate and veto, fail identity",
  "same": [
   "cls",
   "band",
   "week"
  ]
 },
 "engine": "detector_eval_if_h1",
 "evidence_role": "exploratory_historical",
 "exclusions": "Maduro/Venezuela condition ids and catalogue cases (slugs, condition ids)",
 "historical_deviations": [
  "V_m from census prints >= $500 (not all trades, not Gamma liquidity L_m)",
  "class A/B from a frozen keyword rule on market text plus fee category",
  "kappa only within the same market (neg-risk siblings not netted)",
  "no news-burst veto (GDELT live only), no UMA-state veto, no mergeable-positions veto",
  "identity from one /activity page of 500 (plus the latest 500 when full); unknowns fail identity and do not veto",
  "taker prints only: resting-order accumulation invisible",
  "labels from prices-history, not AREPO snapshots"
 ],
 "identity": {
  "activity_page": 500,
  "as_of": "/activity end = t_E - 1",
  "dormant_days": 60,
  "focus_F": 0.8,
  "focus_max_markets": 3,
  "fresh_age_days": 14,
  "fresh_max_prior_trades": 100,
  "unknown": "a None input fails the gate"
 },
 "label": {
  "delta": 0.1,
  "horizon_days": 7,
  "max_quote_age_s": 21600,
  "series": "CLOB prices-history fidelity 10 of token o; history_backfill lag rule",
  "settled_proxy": "series ends before t_a+7d at <= 0.02 or >= 0.98 -> last price"
 },
 "price_bands": [
  0.05,
  0.1,
  0.2
 ],
 "primary": {
  "cluster": "event_key",
  "min_alerts": 30,
  "min_clusters": 10,
  "n_boot": 2000,
  "one_sided": true,
  "seed": 116,
  "statistic": "mean over alerts with >= 1 labelled control of hit - mean(control hits)"
 },
 "rule_id": "if_h1_hist_v1",
 "secondary": [
  "naive ranker: top 10/week by X1 among class A/B, pbar <= 0.20, n_E >= 1000, no X1/identity/veto gates",
  "pi0 = hit rate of the gated pool",
  "mean D_7d",
  "lead to first +0.10 crossing"
 ],
 "selection": {
  "dedupe": "one per (week, event_key, o)",
  "k_per_week": 10,
  "rank": "X1 descending",
  "ties": "(condition_id, t_gate)",
  "week": "ISO week of t_a"
 },
 "theory_ref": "INFORMED_FLOW_SIGNAL_THEORY.md s4 IFC1, s5, s7 IF-H1",
 "unit": {
  "acquisition": "BUY k -> o=k, p=price; SELL k -> o=1-k, p=1-price",
  "alert_latency_s": 600,
  "episode_gap_s": 7200,
  "gate_point": "first print with running n_E >= n_min; S, n_E, pbar are running values there",
  "n_min": 1000.0,
  "prints": "census: /v2/trades takerOnly, cash >= 500"
 },
 "version": "1",
 "vetoes": {
  "end_date_passed": "t_a >= Gamma endDate",
  "kappa": "1 - min(1, S_other/S_o) over the wallet's census prints in the same market in [t_a - 6h, t_a)",
  "kappa_min": 0.5,
  "kappa_window_s": 21600,
  "max_markets_7d": 20,
  "pre_trend_max": 0.15,
  "pre_trend_window_s": 7200,
  "reward_or_merge_30d": true,
  "unknown": "a None input does not veto"
 },
 "windows": {
  "dev": [
   "2025-11-15",
   "2026-01-01"
  ],
  "eval": [
   "2026-01-01",
   "2026-07-30"
  ],
  "overlap": "eval months 2026-01..07 overlap the broad-sample discovery half (tuning data for the 5 unusual-flow variants, different unit and markets); no overlap with the judgement half (>= 2026-07-30T06Z)"
 },
 "x1": {
