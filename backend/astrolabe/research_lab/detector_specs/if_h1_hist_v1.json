  "change_from_v1": "pre-outcome metadata fix: v1 routed fee-less daily sports markets ('Will <club> win on <date>?') into B and matched 'deport*' on club names",
  "text": "title + ' ' + slug + ' ' + event_slug (census) + ' ' + Gamma question",
  "version": "class-v2"
