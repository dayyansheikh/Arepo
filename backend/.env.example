# Astrolabe backend configuration — copy to .env and adjust as needed.
# All values are optional; sensible defaults are baked in. NO secrets are required:
# Astrolabe uses only public, read-only Polymarket endpoints.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Upstream public hosts (read-only) ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- HTTP / WS behaviour ---
HTTP_TIMEOUT_SECONDS=10
WS_STALE_SECONDS=30
WS_PING_INTERVAL_SECONDS=10

# --- Freshness / mode ---
STALE_AFTER_SECONDS=60
DEFAULT_MODE=live          # live | cached | replay

# --- Storage ---
# Local dev uses SQLite. For deployment, set a Postgres URL, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/astrolabe
DATABASE_URL=sqlite+aiosqlite:///./astrolabe.db

# --- API / CORS ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Discovery (be polite to public APIs) ---
DISCOVERY_LIMIT=60
POLL_INTERVAL_SECONDS=15

# --- Accounts / authentication (free accounts unlock alerts, saved markets, preferences) ---
# The public site works with none of these set. Email verification uses the same provider as
# alerts; with the default console sink the verification link is printed to the server log, so
# the whole sign-up flow works locally with no external email account. See docs/authentication.md.
#
# AUTH_SECRET: REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=dev-insecure-secret-change-me-0000000000
AUTH_COOKIE_NAME=arepo_auth
AUTH_COOKIE_SECURE=false        # set true when served over HTTPS
AUTH_TOKEN_LIFETIME_SECONDS=604800
REQUIRE_EMAIL_VERIFICATION=true
ACCOUNT_RATE_LIMIT_PER_MINUTE=10
APP_BASE_URL=http://localhost:3000   # general frontend origin; auth email links are canonical below

# Transactional email templates stay server-side. Stable aliases are the defaults; set these only
# if production uses opaque Resend template IDs instead. Auth links always use the canonical public
# https://www.arepolabs.com origin, never APP_BASE_URL or a frontend NEXT_PUBLIC variable.
# AUTH_EMAIL_SENDER=Arepo <no-reply@arepolabs.com>
# RESEND_TEMPLATE_VERIFY=arepo-verify-email
# RESEND_TEMPLATE_RESET=arepo-reset-password
# RESEND_TEMPLATE_SIGNALS=arepo-signals-digest

# --- Alerts (provider-neutral; external sending OFF unless configured) ---
# ALERT_EMAIL_ENABLED=false
# ALERT_PROVIDER=console         # console | smtp | resend
# ALERT_RECIPIENT=               # e.g. dayyansheikh.work@gmail.com (prepared, empty by default)
# ALERT_SENDER=arepo-alerts@localhost   # for resend, a VERIFIED sender (e.g. alerts@yourdomain)
# RESEND_API_KEY=                # Resend API key (production email; from env only, never commit)
# ALERT_SMTP_HOST=  ALERT_SMTP_PORT=587  ALERT_SMTP_USER=  ALERT_SMTP_PASSWORD=

# --- Production notes (see docs/deployment.md) ---
# In production set: ENVIRONMENT=production, a strong AUTH_SECRET, AUTH_COOKIE_SECURE=true,
# DATABASE_URL to Supabase Postgres (transaction pooler URL for the web runtime), APP_BASE_URL and
# CORS_ORIGINS to the deployed frontend origin, ALERT_PROVIDER=resend + RESEND_API_KEY. Frontend
# sets NEXT_PUBLIC_API_BASE to the deployed backend URL. No secrets are committed.
