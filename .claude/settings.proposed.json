{
  "_note": "INERT PROPOSAL. Activate by renaming to settings.json (see report). Reviewed 2026-10-10: removed 'git branch:*' (it allows branch deletion); project-root-anchored '/' paths so deny rules apply from any subdirectory; pushes now prompt. Hook is best-effort and fails open on its own errors.",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(python scripts/check_v2_contract.py)",
      "Bash(npm test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run lint)",
      "Bash(df -h:*)",
      "Bash(du -sh:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)"
