      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git worktree remove:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_evidence.py\""
          }
        ]
      }
    ]
  }
