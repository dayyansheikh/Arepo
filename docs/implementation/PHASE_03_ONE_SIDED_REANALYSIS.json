ashlib.sha256(proof.read_bytes()).hexdigest(),'verified_artifacts':len(e['artifacts']),'original_result_preserved':True,'old_classification':old['items'][0]['state'],'new_result':r,'accepted_panel':False,'origin_admitted':False,'limitation':'New diagnostic interpretation of preserved prospective raw receipts; no new prospective observation, two-sided recovery, native continuity or predictive evidence.'}\nscript=Path(__file__);out['script']={'source':script.read_text(),'sha256':hashlib.sha256(script.read_bytes()).hexdigest()}\n(repo/'docs/implementation/PHASE_03_ONE_SIDED_REANALYSIS.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\\n')\nprint(json.dumps({k:out[k] for k in ['implementation_commit','verified_artifacts','old_classification','analysis_provenance']}));print(r['items'][0]['state'],r['uncovered_duration_ns'])\n"
