  "limitation": "Candidate accepts floats if passed arbitrary Python objects. Only freshly strict-decoded JSON input is eligible. Must not replace generic canonical_json; no full-frame speed claim.",
  "script": "import json,time,hashlib,inspect\nfrom decimal import Decimal\nfrom pathlib import Path\nfrom astrolabe.feature_store.capture import _strict_json\nfrom astrolabe.feature_store.types import canonical_json,exact_decimal\n\ndef default(value):\n    if isinstance(value,Decimal):\n        return {'$decimal':str(exact_decimal(value))}\n    raise ValueError('unsupported strict JSON type')\n\ndef candidate(value):\n    # Diagnostic only: inputs below originate solely in _strict_json(raw).\n    # NOT a safe replacement for canonical_json on arbitrary caller objects.\n    return json.dumps(value,default=default,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False)\n\nprofile=json.loads(Path('docs/implementation/PHASE_03_FRAME_VERIFICATION_PROFILE.json').read_text())\nroot=Path(profile['source_root']); rows=[]\nfor entry in profile['checks']:\n    raw=(root/entry['capture_id']/'raw.bin').read_bytes()\n    assert hashlib.sha256(raw).hexdigest()==entry['raw_hash']\n    rows.extend(_strict_json(raw)['markets'])\n# Include numerical spelling, nested tags as literal objects, Unicode and escaped strings.\nfixtures=['{\"a\":1.00,\"b\":-0.0,\"c\":1e-40,\"d\":1e40}', '{\"\u00e9\":[true,false,null,\"\\\\n\",\"\u03bb\",{\"$decimal\":\"1.0\"}]}']\nfor raw in fixtures:\n    value=_strict_json(raw); assert candidate(value)==canonical_json(value)\nexpected=[canonical_json(row) for row in rows];times=[]\nfor label,fn in [('original',canonical_json),('candidate',candidate),('candidate',candidate),('original',canonical_json)]:\n    start=time.perf_counter_ns();actual=[fn(row) for row in rows];elapsed=time.perf_counter_ns()-start\n    assert actual==expected\n    times.append({'implementation':label,'elapsed_ns':elapsed})\ne={'decision':'D103','scope':'Read-only strict-JSON-row serialization diagnostic; no product source change, admission or repaired D101','input_profile_sha256':hashlib.sha256(Path('docs/implementation/PHASE_03_FRAME_VERIFICATION_PROFILE.json').read_bytes()).hexdigest(),'rows':len(rows),'input_checks':profile['checks'],'timings':times,'fixtures':fixtures,'parser_source_sha256':hashlib.sha256(inspect.getsource(_strict_json).encode()).hexdigest(),'limitation':'Candidate accepts floats if passed arbitrary Python objects. Only freshly strict-decoded JSON input is eligible. Must not replace generic canonical_json; no full-frame speed claim.','script':Path(__file__).read_text()}\nPath('docs/implementation/PHASE_03_STRICT_JSON_HASH_PROBE.json').write_text(json.dumps(e,indent=2)+'\\n')\nprint(json.dumps({'rows':len(rows),'timings':times}))\n"
}
