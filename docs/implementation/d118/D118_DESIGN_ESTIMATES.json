  "scenarios": {
   "S1": "availability = member two-sided in the Gamma snapshot; trigger probability = pooled sweep rate over all two-sided sweep books (one rate for every member)",
   "S4": "availability as S1; trigger probability member-specific: Jeffreys posterior mean (k+0.5)/(n+1) over the member's own two-sided sweep books, else the pooled sweep rate of its liquidity band",
   "S4h": "S4 with every member's untriggered probability halved: p' = 1-(1-p)/2 (stress)",
   "S4q": "S4 with every member's untriggered probability quartered: p' = 1-(1-p)/4 (harshest defined stress; motivated by both pilots: 10 of 10 assessable members triggered)"
  },
  "strata_draw": "uniform without replacement over all eligible strata (exact elementary-symmetric expectation); within-stratum subsets enumerated exactly when C(n, r) <= subsets, else that many seeded random subsets",
  "trigger": "|bid_size_1 - ask_size_1| / (bid_size_1 + ask_size_1) >= 1/3 on a two-sided sweep book (exact decimal comparison)"
