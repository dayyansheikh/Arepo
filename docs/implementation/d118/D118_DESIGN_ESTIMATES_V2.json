  "scenarios": {
   "S1": "availability = member two-sided in the Gamma snapshot; trigger probability = pooled sweep rate over all two-sided sweep books (one rate for every member)",
   "S4": "availability as S1; trigger probability member-specific: Jeffreys posterior mean (k+0.5)/(n+1) over the member's own two-sided sweep books, else the pooled sweep rate of its liquidity band",
