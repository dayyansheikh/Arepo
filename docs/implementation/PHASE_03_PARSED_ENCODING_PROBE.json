  "script": "import json,time,hashlib\nfrom pathlib import Path\nfrom astrolabe.feature_store.capture import _strict_json,_json_bytes\nfrom astrolabe.feature_store.types import canonical_value\nroot=Path('data-dumps/fs2_capture_2413ff8c20c04a4ba31763fdadd3a84e').resolve()\nprofile=json.loads(Path('docs/implementation/PHASE_03_POST_RECEIPT_PROFILE.json').read_text());values=[]\nfor item in profile['checks']:\n folder=root/item['capture_id'];raw=(folder/'raw.bin').read_bytes();assert hashlib.sha256(raw).hexdigest()==item['raw_hash']\n saved=(folder/'parsed.json').read_bytes();parsed=_strict_json(saved);assert parsed['parse_error'] is None\n parsed['value']=_strict_json(raw);values.append((parsed,saved))\ndef candidate(value):\n return json.dumps(value,default=canonical_value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode('utf-8')\ntimes=[]\nfor label,fn in [('original',_json_bytes),('candidate',candidate),('candidate',candidate),('original',_json_bytes)]:\n start=time.perf_counter_ns()\n for value,saved in values:assert fn(value)==saved\n times.append({'implementation':label,'elapsed_ns':time.perf_counter_ns()-start})\ne={'decision':'D107','scope':'Strict decoded parsed-journal serialization only; no source edits, rewritten records or full-path claim','checks':profile['checks'],'timings':times,'script':Path(__file__).read_text(),'limitation':'Only internally constructed parsed envelopes with freshly strict-decoded JSON qualify; this is not safe as a generic canonical encoder.'}\nPath('docs/implementation/PHASE_03_PARSED_ENCODING_PROBE.json').write_text(json.dumps(e,indent=2)+'\\n');print(json.dumps(times))\n",
  "limitation": "Only internally constructed parsed envelopes with freshly strict-decoded JSON qualify; this is not safe as a generic canonical encoder."
